# 11.8 Streisand — comparação de curtidas
fig, ax = plt.subplots(figsize=(8, 6))
grupos = ["Com sinal\nStreisand", "Demais\ncomentários"]
medias = [df.loc[df["streisand_flag"], "curtidas"].mean(),
          df.loc[~df["streisand_flag"], "curtidas"].mean()]
ax.bar(grupos, medias, color=["#e67e22", "#7f8c8d"])
ax.set_title("Curtidas médias: Streisand vs. demais")
ax.set_ylabel("Curtidas médias")
for i, v in enumerate(medias):
    ax.text(i, v, f"{v:.1f}", ha="center", va="bottom", fontsize=12)
plt.tight_layout()
plt.savefig(os.path.join(OUTPUT_DIR, "08_streisand_curtidas.png"), dpi=150)
plt.close()

