# 11.5 LDA — palavras de cada tópico
fig, axes = plt.subplots(1, N_TOPICOS_LDA, figsize=(5 * N_TOPICOS_LDA, 6), sharex=False)
cores_lda = ["#e74c3c", "#3498db", "#2ecc71", "#f39c12", "#9b59b6", "#1abc9c"]
for i, comp in enumerate(lda.components_):
    top_idx = comp.argsort()[-10:]
    palavras = [vocab_lda[t] for t in top_idx]
    pesos = comp[top_idx]
    ax = axes[i] if N_TOPICOS_LDA > 1 else axes
    ax.barh(palavras, pesos, color=cores_lda[i % len(cores_lda)])
    ax.set_title(f"Tópico {i+1}")
plt.suptitle("LDA — termos mais representativos por tópico", fontsize=14)
plt.tight_layout()
plt.savefig(os.path.join(OUTPUT_DIR, "05_lda_topicos.png"), dpi=150)
