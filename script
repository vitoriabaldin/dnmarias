# 12. EXPORTAR XLSX (dados limpos na 1ª aba)
# ============================================================
xlsx_path = os.path.join(OUTPUT_DIR, "analise_instagram.xlsx")
with pd.ExcelWriter(xlsx_path, engine="openpyxl") as w:
    # 1ª aba: dados limpos
    df_clean_export = df[[
        "usuario", "tempo", "comentario", "curtidas",
        "streisand_flag", "streisand_categorias"
    ]].copy()
    df_clean_export.to_excel(w, sheet_name="1_dados_limpos", index=False)

    freq_df.head(100).to_excel(w, sheet_name="2_freq_palavras", index=False)
    tfidf_df.head(100).to_excel(w, sheet_name="3_tfidf", index=False)
    cooc_df.head(100).to_excel(w, sheet_name="4_coocorrencia", index=False)
    topicos_df.to_excel(w, sheet_name="5_lda_topicos", index=False)
    df_an[["comentario", "topico_dominante", "topico_score"]].to_excel(
        w, sheet_name="5b_lda_por_comentario", index=False
    )
    emoji_df.to_excel(w, sheet_name="6_top_emojis", index=False)
    top_coms.to_excel(w, sheet_name="7_top_comentarios", index=False)
    streisand_resumo.to_excel(w, sheet_name="8_streisand_resumo", index=False)
    streisand_counts.to_excel(w, sheet_name="8b_streisand_categorias", index=False)
    streisand_exemplos.to_excel(w, sheet_name="8c_streisand_exemplos", index=False)

