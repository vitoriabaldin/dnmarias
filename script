"""
Análise dos comentários do Instagram (efeito Streisand + NLP).
Output: 1 XLSX com várias abas + PNGs.
"""
import os
import re
from collections import Counter
from itertools import combinations

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import emoji
from wordcloud import WordCloud
from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer
from sklearn.decomposition import LatentDirichletAllocation

# ============================================================
# CONFIG
# ============================================================
INPUT_CSV  = r"C:\Users\viihb\Downloads\instagram(2).csv"
OUTPUT_DIR = r"C:\Users\viihb\Downloads\analise_instagram"
os.makedirs(OUTPUT_DIR, exist_ok=True)

N_TOPICOS_LDA = 4
TOP_N_PALAVRAS = 30
TOP_N_PARES    = 30
TOP_N_EMOJIS   = 20
TOP_N_COMS     = 25

# ============================================================
# 1. CARREGAR + MAPEAR COLUNAS POR POSIÇÃO
# ============================================================
# As colunas do scraper têm nomes gigantes (seletores CSS).
# Pela inspeção do CSV: idx 3=usuário, 5=tempo, 6=texto, 7=curtidas
try:
    raw = pd.read_csv(INPUT_CSV, encoding="utf-8")
except UnicodeDecodeError:
    raw = pd.read_csv(INPUT_CSV, encoding="latin-1")

print(f"Linhas no CSV: {len(raw)} | Colunas: {len(raw.columns)}")

df = pd.DataFrame({
    "usuario":      raw.iloc[:, 3].astype(str).str.strip(),
    "tempo":        raw.iloc[:, 5].astype(str).str.strip(),
    "comentario":   raw.iloc[:, 6].astype(str).str.strip(),
    "curtidas_raw": raw.iloc[:, 7].astype(str).str.strip(),
})

# parsear "111 curtidas", "1,2 mil curtidas" etc.
def parse_likes(s):
    if pd.isna(s) or str(s).lower() in {"nan", ""}:
        return 0
    s_low = str(s).lower()
    m = re.search(r"(\d+(?:[.,]\d+)?)", s_low)
    if not m:
        return 0
    num = m.group(1).replace(".", "").replace(",", ".")
    try:
        v = float(num)
        if "mil" in s_low:
            v *= 1000
        return int(v)
    except ValueError:
        return 0

df["curtidas"] = df["curtidas_raw"].apply(parse_likes)

# limpar linhas vazias / NaN textuais
df = df[df["comentario"].notna()]
df = df[~df["comentario"].str.lower().isin(["nan", "", "responder", "curtir"])]
df = df.drop_duplicates(subset=["usuario", "comentario"]).reset_index(drop=True)
print(f"Comentários limpos: {len(df)}")

# ============================================================
# 2. STOPWORDS PT-BR (hardcoded — não precisa do NLTK)
# ============================================================
