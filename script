""".split())

# ============================================================
# 3. LIMPEZA DE TEXTO
# ============================================================
def limpar_texto(t):
    t = t.lower()
    t = emoji.replace_emoji(t, "")
    t = re.sub(r"http\S+|www\S+", " ", t)
    t = re.sub(r"@\w+", " ", t)
    t = re.sub(r"#\w+", " ", t)
    t = re.sub(r"[^a-záàâãéèêíïóôõöúçñ\s]", " ", t)
    return re.sub(r"\s+", " ", t).strip()

df["texto_limpo"] = df["comentario"].apply(limpar_texto)
df_an = df[df["texto_limpo"].str.len() > 2].reset_index(drop=True)
print(f"Comentários válidos para análise: {len(df_an)}")

# ============================================================
# 4. FREQUÊNCIA SIMPLES (CountVectorizer)
# ============================================================
cv = CountVectorizer(stop_words=list(STOP_PT), min_df=2)
Xc = cv.fit_transform(df_an["texto_limpo"])
freq_df = (
    pd.DataFrame({
        "termo": cv.get_feature_names_out(),
        "frequencia": np.asarray(Xc.sum(axis=0)).flatten(),
        "n_comentarios": np.asarray((Xc > 0).sum(axis=0)).flatten(),
    })
    .sort_values("frequencia", ascending=False)
    .reset_index(drop=True)
)

# ============================================================
# 5. TF-IDF
# ============================================================
tv = TfidfVectorizer(stop_words=list(STOP_PT), min_df=2, max_df=0.85)
Xt = tv.fit_transform(df_an["texto_limpo"])
tfidf_df = (
    pd.DataFrame({
        "termo": tv.get_feature_names_out(),
        "tfidf_medio": np.asarray(Xt.mean(axis=0)).flatten(),
        "freq_doc":    np.asarray((Xt > 0).sum(axis=0)).flatten(),
    })
    .sort_values("tfidf_medio", ascending=False)
    .reset_index(drop=True)
)

# ============================================================
# 6. CO-OCORRÊNCIA (pares no mesmo comentário)
# ============================================================
pares = Counter()
for txt in df_an["texto_limpo"]:
    toks = sorted({w for w in txt.split() if len(w) > 3 and w not in STOP_PT})
    for a, b in combinations(toks, 2):
        pares[(a, b)] += 1
cooc_df = pd.DataFrame(
    [(a, b, c) for (a, b), c in pares.most_common(200)],
    columns=["palavra_1", "palavra_2", "co_ocorrencias"]
)

# ============================================================
# 7. LDA (modelagem de tópicos)
# ============================================================
cv_lda = CountVectorizer(stop_words=list(STOP_PT), min_df=3, max_df=0.7)
Xl = cv_lda.fit_transform(df_an["texto_limpo"])
lda = LatentDirichletAllocation(
    n_components=N_TOPICOS_LDA, random_state=42,
    max_iter=25, learning_method="batch"
)
lda.fit(Xl)
vocab_lda = cv_lda.get_feature_names_out()

topicos_rows = []
for i, comp in enumerate(lda.components_):
    top_idx = comp.argsort()[-10:][::-1]
    palavras = [vocab_lda[t] for t in top_idx]
    topicos_rows.append({
        "topico":      f"Tópico {i+1}",
        "palavras_chave": ", ".join(palavras),
        "peso_total":  float(comp.sum()),
    })
topicos_df = pd.DataFrame(topicos_rows)

# rotular cada comentário com o tópico dominante
doc_topic = lda.transform(Xl)
df_an["topico_dominante"] = [f"Tópico {i+1}" for i in doc_topic.argmax(axis=1)]
df_an["topico_score"]     = doc_topic.max(axis=1)

# ============================================================
# 8. EMOJIS
# ============================================================
todos_emojis = []
for txt in df["comentario"]:
    todos_emojis.extend(c["emoji"] for c in emoji.emoji_list(txt))
emoji_df = pd.DataFrame(
    Counter(todos_emojis).most_common(TOP_N_EMOJIS),
    columns=["emoji", "frequencia"]
)

# ============================================================
# 9. TOP COMENTÁRIOS POR CURTIDA
# ============================================================
top_coms = (
    df.sort_values("curtidas", ascending=False)
      .head(TOP_N_COMS)
      [["usuario", "comentario", "curtidas", "tempo"]]
      .reset_index(drop=True)
)

# ============================================================
# 10. EFEITO STREISAND
# ============================================================
streisand_patterns = {
    "01_pedindo_o_arroba":   r"\b(?:cad[êe]|qual) (?:o |a )?@|\bmanda o (?:link|@|arroba)|\bonde (?:fica|acho) (?:o |a )?(?:perfil|p[áa]gina)",
    "02_vou_seguir":         r"\b(?:vou|fui|t[ôo]) seguir\b|\bj[áa] (?:vou |quero )?seguir\b|\bcome[çc](?:ando|ei) a seguir\b",
    "03_ganhou_seguidor":    r"\bganh(?:ou|aram) (?:mais )?(?:um |uma )?(?:novo |nova )?seguidor",
    "04_cheguei_descobri":   r"\b(?:cheguei|vim) (?:aqui|agora|por causa)|\b(?:descobri|conheci) (?:o |a |essa |esse )?(?:perfil|p[áa]gina|canal|conta)",
    "05_nao_conhecia":       r"\bn[ãa]o conhecia\b",
    "06_obrigado_pt":        r"\bgra[çc]as ao pt\b|\bobrigad\w+ (?:ao )?pt\b|\bobrigad\w+ (?:ao )?lula\b",
    "07_propaganda":         r"\b(?:melhor|boa|bela|grande) propaganda\b|\bfizeram propaganda\b|\bdivulga(?:ndo|ção|ram)\b",
    "08_dando_ibope":        r"\bdando (?:audi[êe]ncia|ibope|visualiza[çc][ãa]o|engajamento)\b",
    "09_pediram_tirar":      r"\b(?:tirar|derrubar|denunciar|apagar|banir|excluir|deletar) (?:o |a |essa |esse )?(?:perfil|p[áa]gina|conta|post|v[íi]deo)",
    "10_censura":            r"\bcensura\w*\b|\bcalar (?:a |o )?(?:boca|povo)",
    "11_efeito_streisand":   r"\b(?:efeito )?streisand\b",
    "12_quero_conhecer":     r"\bquero (?:conhecer|seguir|ver) (?:o |a |essa |esse )?(?:perfil|p[áa]gina|conta)",
}
streisand_re = {k: re.compile(p, re.IGNORECASE) for k, p in streisand_patterns.items()}

categorias_hit = []
flags = []
for txt in df["comentario"]:
    cats = [k for k, pat in streisand_re.items() if pat.search(txt)]
    categorias_hit.append(", ".join(cats))
    flags.append(bool(cats))
df["streisand_categorias"] = categorias_hit
df["streisand_flag"]       = flags

streisand_counts = (
    pd.DataFrame(
        [(k.split("_", 1)[1], sum(streisand_re[k].search(t) is not None for t in df["comentario"]))
         for k in streisand_patterns],
        columns=["categoria", "n_comentarios"]
    )
    .sort_values("n_comentarios", ascending=False)
    .reset_index(drop=True)
)

streisand_resumo = pd.DataFrame({
    "metrica": [
        "Total de comentários",
        "Comentários com sinal Streisand",
        "% Streisand",
        "Curtidas médias (Streisand)",
        "Curtidas médias (demais)",
        "Curtidas medianas (Streisand)",
        "Curtidas medianas (demais)",
    ],
    "valor": [
        len(df),
        int(df["streisand_flag"].sum()),
        round(df["streisand_flag"].mean() * 100, 2),
        round(df.loc[df["streisand_flag"], "curtidas"].mean(), 2),
        round(df.loc[~df["streisand_flag"], "curtidas"].mean(), 2),
        df.loc[df["streisand_flag"], "curtidas"].median(),
        df.loc[~df["streisand_flag"], "curtidas"].median(),
    ],
})

streisand_exemplos = (
    df[df["streisand_flag"]]
    .sort_values("curtidas", ascending=False)
    [["usuario", "comentario", "curtidas", "streisand_categorias"]]
    .head(50)
    .reset_index(drop=True)
)

